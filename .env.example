# ------------------------------------------------------------------
# BizPilot — environment variables
# Copy to .env and fill in. NOTHING is required for local development:
# BizPilot's on-device AI engine, in-app messaging and the mock
# payment/messaging providers all work without external credentials.
# ------------------------------------------------------------------

# PostgreSQL connection string (Neon in production, local Postgres in dev)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Public base URL of the app (used in metadataBase, sitemap, robots, emails, PDFs, OG tags).
# IMPORTANT: leave this UNSET rather than empty. On Vercel the app auto-derives the URL
# from VERCEL_URL, and an empty string is safely ignored (never passed to new URL()).
# Set it explicitly only when you have a stable custom domain, e.g. https://app.bizpilot.co.za
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: external LLM provider for the AI assistant.
# When unset, BizPilot uses its deterministic on-device engine, which
# only ever reports real data from the business's own database.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# WhatsApp Business API (Meta Cloud API) — mock provider used until set
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# Yoco payments — mock provider used until configured
YOCO_MERCHANT_KEY=
YOCO_SECRET=
YOCO_CLIENT_ID=

# Transactional email (SMTP) — mock provider used until set
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BizPilot <no-reply@bizpilot.co.za>

# Feature flags
NEXT_PUBLIC_DEMO_ENABLED=true
